# ─────────────────────────────────────────────────────────────
# HEAVEN-GeoIntel: API Keys Configuration
# Copy this file to .env.local and fill in the keys you want.
# All keys are optional. The tool works fully without any key.
# ─────────────────────────────────────────────────────────────

# ── Phone Enrichment ─────────────────────────────────────────

# NumVerify: https://numverify.com (free tier: 100 req/month)
NUMVERIFY_API_KEY=

# IPQualityScore: https://www.ipqualityscore.com (free tier: 200 req/day)
# Adds: fraud score · VoIP flag · prepaid · abuse · carrier · city
IPQS_API_KEY=

# AbstractAPI: https://www.abstractapi.com (free tier: 250 req/month)
# Used for both phone validation and email validation
ABSTRACT_API_KEY=

# Twilio Lookup v2: https://www.twilio.com (pay-per-use, ~$0.005/lookup)
# Adds: carrier name · owner/CNAM · MCC/MNC
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ── Email Enrichment ──────────────────────────────────────────

# Hunter.io: https://hunter.io (free tier: 25 req/month)
# Adds: email deliverability · confidence score · SMTP check
HUNTER_API_KEY=

# EmailRep.io: https://emailrep.io (works without key, key gives higher quota)
# Adds: reputation · breach flags · platform registrations
EMAILREP_API_KEY=

# FullContact: https://www.fullcontact.com (free tier: 500 req/month)
# Adds: real name · age · employer · social profiles · linked emails & phones
FULLCONTACT_API_KEY=

# BreachDirectory via RapidAPI: https://rapidapi.com/rohan-patra/api/breachdirectory
# Adds: real SHA-1/MD5 credential hashes from 3.5B+ leaked records
# Free tier: 50 req/day
RAPIDAPI_KEY=

# ── Security / Operations (all optional) ─────────────────────

# Auth gate (HTTP Basic). Leave AUTH_PASSWORD blank to keep the app OPEN
# (default, single-user self-host). Set it to require login before exposing
# the tool on a public/shared network. /api/health stays open for probes.
AUTH_USER=analyst
AUTH_PASSWORD=

# Audit log: by default targets are stored HASHED (salted SHA-256) in
# .data/audit.log so the log isn't a fresh pile of PII. Set to 1 to store the
# raw phone/email/etc. instead (regulated environments that require it).
AUDIT_PLAINTEXT=

# Trust X-Forwarded-For / X-Real-IP for per-client rate-limiting. Enable ONLY
# when running behind a proxy you control (nginx, Caddy, Cloudflare, …).
TRUST_PROXY=

# Case lock. AUTH_PASSWORD gates the whole app; this gates ONLY /api/cases,
# so lookups stay open while the case store, the one thing on disk that
# accumulates investigation targets, needs a password. Blank = disabled (the
# default, a complete no-op). Changing it invalidates every issued token.
CASE_PASSWORD=

# How long a case unlock lasts, in ms. Default 43200000 (12 h).
# Clamped to 60000 … 2592000000 (1 min … 30 days).
CASE_UNLOCK_TTL_MS=

# Where the case store, API keys and audit log are written.
# Default: ./.data next to the project. Point it at an encrypted volume if you
# want the case store to live somewhere other than the repo.
HV_DATA_DIR=

# ── Runtime tuning (all optional) ────────────────────────────────────────────
# Every value below has the historical hardcoded default. Junk is ignored and
# clamped to the stated range, so a typo can never disable rate limiting.

# Rate limiting: per client (one bucket per browser, or per IP behind a
# trusted proxy) and a server-wide ceiling that protects free upstream tiers
# from a script that discards its cookie. A request rejected by the ceiling is
# not charged to the client.
RATE_LIMIT_MAX=            # default 60      (1 … 100000) requests per window
RATE_LIMIT_WINDOW_MS=      # default 60000   (1000 … 3600000)
RATE_LIMIT_GLOBAL_MAX=     # default 600     (1 … 1000000) across all clients

# Result caches. TTL 0 disables caching entirely.
CACHE_TTL_MS=              # phone, default 86400000 (0 … 30 days)
CACHE_MAX_ENTRIES=         # phone, default 1000     (1 … 1000000)
EMAIL_CACHE_TTL_MS=        # default: whatever CACHE_TTL_MS resolves to
EMAIL_CACHE_MAX_ENTRIES=   # default 500             (1 … 1000000)

# IP results. Shorter by default (1 h) because an IP's open ports and scanner
# classification move faster than a phone number's carrier. This cache is also
# what keeps a repeated lookup, a refresh or a re-opened share link from
# spending ip-api.com's 45-requests-per-minute budget.
IP_CACHE_TTL_MS=           # default 3600000 (1 h)   (0 … 30 days)
IP_CACHE_MAX_ENTRIES=      # default 500             (1 … 1000000)

# Upstream behaviour. The timeout is per source: one slow API never holds up
# the rest of a fanout. Higher concurrency is faster but more likely to trip an
# upstream's own per-IP throttle.
SOURCE_TIMEOUT_MS=         # default 8000    (500 … 120000)
FANOUT_CONCURRENCY=        # default 12      (1 … 128)

# How many lookup snapshots a case keeps PER identifier, for change tracking.
CASE_SNAPSHOT_HISTORY=     # default 5       (1 … 200)

# Emit HSTS + upgrade-insecure-requests. Only for a build that will be served
# over HTTPS. On plain HTTP it makes the browser refuse the very origin
# serving it. Next bakes headers() into the build, so this must be set at
# BUILD time, not just at `next start`.
FORCE_HTTPS=

# Emit `output: "standalone"`: a self-contained .next/standalone/server.js that
# runs on plain node with no npm install. Set only by the release workflow when
# it packages the downloadable bundle; the Dockerfile deliberately copies a
# normal build instead. BUILD time only, and not something you need locally.
BUILD_STANDALONE=
