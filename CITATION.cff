# This CITATION.cff lets GitHub show a "Cite this repository" button and lets
# tools export APA / BibTeX. The `version` and `date-released` fields are held
# to src/lib/version.ts and the CHANGELOG by tests/versionSync.test.ts, so they
# cannot drift on a release.
cff-version: 1.2.0
message: "If you use HEAVEN-GeoIntel in your research or reporting, please cite it using the metadata below."
title: "HEAVEN-GeoIntel: Unified OSINT Intelligence Platform"
abstract: >-
  An offline-first, unified OSINT platform for phone numbers, email addresses,
  usernames, IP addresses, domains, crypto wallets and file hashes, with a
  link-analysis graph, persistent cases and zero required API keys. Built for
  penetration testers, security researchers and OSINT analysts.
type: software
authors:
  - family-names: Chasmawala
    given-names: Nisarg
    alias: HEAVEN
    website: "https://www.linkedin.com/in/nisarg-chasmawala"
repository-code: "https://github.com/nishu2402/HEAVEN-GeoIntel"
url: "https://github.com/nishu2402/HEAVEN-GeoIntel"
license: MIT
version: 3.5.0
date-released: 2026-11-16
keywords:
  - osint
  - threat-intelligence
  - penetration-testing
  - breach-intelligence
  - phone-intelligence
  - email-intelligence
  - cryptocurrency-forensics
  - nextjs
  - typescript
