{
  "name": "heaven-geointel",
  "version": "1.3.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev",
    "build": "node node_modules/next/dist/bin/next build",
    "start": "node node_modules/next/dist/bin/next start",
    "lint": "node node_modules/eslint/bin/eslint.js src tests",
    "test": "node node_modules/vitest/vitest.mjs run",
    "test:watch": "node node_modules/vitest/vitest.mjs",
    "test:coverage": "node node_modules/vitest/vitest.mjs run --coverage",
    "test:e2e": "node node_modules/@playwright/test/cli.js test",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "setup": "npm install && node node_modules/next/dist/bin/next dev",
    "install-global": "bash scripts/install-global.sh",
    "uninstall-global": "bash scripts/uninstall-global.sh",
    "doctor": "bash scripts/start.sh --doctor",
    "screenshots": "node scripts/capture-screenshots.mjs"
  },
  "dependencies": {
    "@radix-ui/react-tabs": "^1.1.13",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "country-data-list": "^1.6.2",
    "framer-motion": "^12.38.0",
    "libphonenumber-js": "^1.13.0",
    "lucide-react": "^1.14.0",
    "next": "^16.2.6",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@playwright/test": "^1.60.0",
    "@types/node": "20.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.2.6",
    "postcss": "^8",
    "puppeteer-core": "^22.15.0",
    "tailwindcss": "^3.4.1",
    "typescript": "5.8.2",
    "vitest": "^4.1.8"
  }
}
