    "@types/react-dom": "^18",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^8",
    "eslint-config-next": "^15.3.9",
    "postcss": "^8",
    "puppeteer-core": "^22.15.0",
    "tailwindcss": "^3.4.1",
