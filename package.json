{
  "name": "heaven-geointel",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev-open.mjs",
    "build": "node node_modules/next/dist/bin/next build",
    "start": "node node_modules/next/dist/bin/next start",
    "lint": "node node_modules/eslint/bin/eslint.js src tests",
    "test": "node node_modules/vitest/vitest.mjs run",
    "test:watch": "node node_modules/vitest/vitest.mjs",
    "test:coverage": "node node_modules/vitest/vitest.mjs run --coverage",
    "test:e2e": "node node_modules/@playwright/test/cli.js test",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "setup": "npm install && node scripts/dev-open.mjs",
    "install-global": "bash scripts/install-global.sh",
    "uninstall-global": "bash scripts/uninstall-global.sh",
    "doctor": "bash scripts/start.sh --doctor",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "brand": "npm run brand:poster && node scripts/generate-brand-assets.mjs",
    "brand:poster": "node --import ./scripts/ts-resolve.mjs scripts/generate-poster.mjs"
  },
  "dependencies": {
    "@radix-ui/react-tabs": "^1.1.13",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "country-data-list": "^1.6.2",
    "framer-motion": "^12.38.0",
    "libphonenumber-js": "^1.13.0",
    "lucide-react": "^1.14.0",
    "next": "^16.2.12",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.3.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "jsdom": "^29.1.1",
    "postcss": "^8",
    "puppeteer-core": "^25.3.0",
    "tailwindcss": "^4.3.2",
    "typescript": "6.0.3",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "^0.35.3"
  }
}
