              },
              "fullDescription": {
                "text": "A MySQL / MariaDB service is reachable on a public/routable address. Databases must never be directly exposed to untrusted networks \u2014 bind to localhost or a private management network, require authentication and TLS, and firewall the port to known application hosts only."
              },
              "helpUri": "https://github.com/heaven-security/heaven",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security"
                ],
                "security-severity": "8.6"
              }
