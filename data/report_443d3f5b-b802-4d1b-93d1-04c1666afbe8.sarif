{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "HEAVEN",
          "version": "2.1.0",
          "informationUri": "https://github.com/heaven-security/heaven",
          "rules": [
            {
              "id": "mx_enumeration",
              "name": "MX Records: 1 mail servers",
              "shortDescription": {
                "text": "MX Records: 1 mail servers"
              },
              "fullDescription": {
                "text": "Mail servers: mail.certifiedhacker.com"
              },
              "helpUri": "https://github.com/heaven-security/heaven",
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "security"
                ],
                "security-severity": "1.0"
              }
            },
            {
              "id": "spf_analysis",
              "name": "SPF Issues: certifiedhacker.com",
              "shortDescription": {
                "text": "SPF Issues: certifiedhacker.com"
              },
              "fullDescription": {
                "text": "SPF uses '?all' (neutral) \u2014 provides no protection"
              },
              "helpUri": "https://github.com/heaven-security/heaven",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security"
                ],
                "security-severity": "6.2"
              }
            },
            {
              "id": "dkim_found",
              "name": "DKIM: 1 selectors found",
              "shortDescription": {
                "text": "DKIM: 1 selectors found"
              },
              "fullDescription": {
                "text": "Active selectors: default"
              },
              "helpUri": "https://github.com/heaven-security/heaven",
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "security"
                ],
                "security-severity": "1.0"
              }
            },
            {
              "id": "dmarc_missing",
              "name": "DMARC Record Missing",
              "shortDescription": {
                "text": "DMARC Record Missing"
              },
              "fullDescription": {
                "text": "No DMARC policy for certifiedhacker.com. Emails can bypass SPF/DKIM checks without any policy enforcement."
              },
              "helpUri": "https://github.com/heaven-security/heaven",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security"
                ],
                "security-severity": "6.2"
              }
            },
            {
              "id": "dnssec_missing",
              "name": "DNSSEC Not Configured",
              "shortDescription": {
                "text": "DNSSEC Not Configured"
              },
              "fullDescription": {
                "text": "Domain certifiedhacker.com has no DNSSEC signature records. DNS responses can be forged (cache poisoning, Kaminsky attack)."
              },
              "helpUri": "https://github.com/heaven-security/heaven",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "security"
                ],
                "security-severity": "4.6"
              }
            },
            {
              "id": "mta_sts_missing",
              "name": "MTA-STS not configured: certifiedhacker.com",
              "shortDescription": {
                "text": "MTA-STS not configured: certifiedhacker.com"
              },
              "fullDescription": {
                "text": "No MTA-STS policy \u2014 sending servers cannot enforce TLS and may be downgraded to cleartext by an on-path attacker."
              },
              "helpUri": "https://github.com/heaven-security/heaven",
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "security"
                ],
                "security-severity": "4.6"
              }
            },
            {
              "id": "exposed_database",
              "name": "Exposed MYSQL service on port 3306",
              "shortDescription": {
                "text": "Exposed MYSQL service on port 3306"
              },
              "fullDescription": {
                "text": "Exposed MYSQL service on port 3306"
              },
              "helpUri": "https://github.com/heaven-security/heaven",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security"
                ],
                "security-severity": "8.6"
              }
            },
            {
              "id": "unsupported_software",
              "name": "Unsupported / End-of-Life Software: MySQL 5.7.44",
              "shortDescription": {
                "text": "Unsupported / End-of-Life Software: MySQL 5.7.44"
              },
              "fullDescription": {
                "text": "MySQL branches before 8.0 (e.g. 5.7) reached end of life in 2023. End-of-life software receives no security patches; treat this as a proof-of-concept for the wider estate and inventory/upgrade all affected instances."
              },
              "helpUri": "https://github.com/heaven-security/heaven",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "security",
                  "CWE-1104"
                ],
                "security-severity": "7.4"
              }
            },
            {
              "id": "cleartext_service",
