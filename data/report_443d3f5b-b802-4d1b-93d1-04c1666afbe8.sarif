              "shortDescription": {
                "text": "Cleartext Service Exposed: FTP (port 21)"
              },
              "fullDescription": {
                "text": "FTP authenticates and transfers data in cleartext, exposing credentials and files to network sniffing. Disable it and use an encrypted equivalent (SSH/SFTP/HTTPS) restricted to a management network."
              },
              "helpUri": "https://github.com/heaven-security/heaven",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "security"
                ],
                "security-severity": "7.5"
              }
            },
